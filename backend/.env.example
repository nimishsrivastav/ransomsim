# Application
APP_NAME=RansomSim: AI‑Driven Ransomware Negotiation Training
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=False  # Set to True only for local development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","https://ransomsim.com"]

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEMPERATURE=0.8

# Session Settings
SESSION_EXPIRATION_HOURS=48
MAX_MESSAGES_PER_SESSION=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
